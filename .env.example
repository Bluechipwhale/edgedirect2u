NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Accepts Supabase's sb_publishable_ public key in this variable.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Optional when reservation expiry runs directly through Supabase Cron.
CRON_SECRET=
# Only permits a sandbox administrator on localhost, never production.
LOCAL_DEMO=true
LOCAL_DATABASE_PATH=.data/edgedirect2u.sqlite
# Deployment tools only; never NEXT_PUBLIC_ and never included in the client.
DATABASE_URL=
DATABASE_CA_PATH=
